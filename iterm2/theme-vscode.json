  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a8b4a8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#ffbb6c"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#ff6969"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#a36ac7"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#a36ac7"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#6fc674"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#ff6969"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff6969"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff6969"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff6969"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff6969"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "fontStyle": "italic underline",
        "background": "#a36ac7",
        "foreground": "#c5c8c6",
        "content": "^M"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#ff6969"
      }
    },
    {
      "scope": "string source",
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6fc674"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#ffbb6c"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6fc674"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c5c8c6"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#c5c8c6"
      }
    },
    {
      "scope": "markup.raw",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "background": "#ff6969",
        "foreground": "#ff6969"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "background": "#6fc674",
        "foreground": "#6fc674"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "background": "#ffbb6c",
        "foreground": "#ffbb6c"
      }
    },
    {
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "foreground": "#1d1f21",
        "background": "#78dcf3"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "foreground": "#a36ac7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#78dcf3"
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#a8b4a8"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#ff6969"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#78dcf3",
        "fontStyle": "underline"
      }
    }
  ]
}